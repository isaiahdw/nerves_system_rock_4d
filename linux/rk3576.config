# Vendor Mali Bifrost kmod for the G52 (pairs with the libmali userspace).
# EXPERT is required to set the platform name. DEBUG defaults on in this
# tree and must be disabled explicitly — it only adds logging and runtime
# checks to every kbase call.
CONFIG_MALI_BIFROST=y
CONFIG_MALI_PLATFORM_NAME="rk"
CONFIG_MALI_BIFROST_EXPERT=y
# CONFIG_MALI_BIFROST_DEBUG is not set
